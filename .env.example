# ── App ──────────────────────────────────────────────
APP_NAME=ORCA
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orca
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca_secret
DATABASE_URL=postgresql+asyncpg://orca:orca_secret@localhost:5432/orca

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=ollama           # ollama | vllm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:12b
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=google/gemma-4-12b

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ── Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── External APIs ─────────────────────────────────────
INCOIS_API_KEY=
MOSDAC_API_KEY=
IMD_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── Notifications ─────────────────────────────────────
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Monitoring ────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
